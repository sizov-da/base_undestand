body, html { padding: 0px; margin: 0px; min-height: 100%; }

[contenteditable=3D"true"]:focus, button:focus, input:focus, textarea:focus=
 { outline: 0px; }

textarea { resize: none; }

.tl_page_wrap { display: flex; flex-direction: column; min-height: var(--vi=
ewport-height,100vh); }

.tl_page { max-width: 732px; margin: 0px auto; position: relative; padding:=
 21px 0px; width: 100%; flex-grow: 1; }

.tl_page_footer { background-color: rgb(242, 242, 242); display: none; }

.tl_page_footer_visible { display: block; }

.tl_footer_button { font-family: CustomSansSerif, "Lucida Grande", Arial, s=
ans-serif; font-size: 13px; line-height: 16px; padding: 8px 15px; color: rg=
b(136, 136, 136); text-align: center; cursor: pointer; }

.button { font-family: CustomSansSerif, "Lucida Grande", Arial, sans-serif;=
 font-weight: 600; font-style: normal; font-size: 17px; color: rgb(0, 0, 0)=
; text-decoration: none; border: 2px solid rgb(51, 51, 51); border-radius: =
16px; text-transform: uppercase; padding: 4px 12px; margin: 0px 0px 15px; b=
ackground-color: rgb(255, 255, 255); cursor: pointer; }

.tl_message { font-family: CustomSansSerif, "Lucida Grande", Arial, sans-se=
rif; padding: 70px 0px; color: rgb(121, 130, 139); text-align: center; }

.tl_message h1 { font-size: 120px; margin: 0px; }

.tl_popup_buttons { padding: 70px 0px; }

.tl_popup_buttons .button { display: inline-block; margin: 0px; }

.tl_popup_buttons .button + .button { margin-left: 12px; }

.tl_article_buttons { position: fixed; left: 50%; top: 0px; right: 0px; mar=
gin: 46px 0px 0px 376px; }

@media (max-width: 960px) {
  .tl_article_buttons { position: static; width: auto; margin: 30px 21px; p=
adding: 1px 0px; }
}

.tl_article_buttons .button { transition: opacity 0.4s; visibility: hidden;=
 opacity: 0; }

.tl_article_buttons .edit_button { position: absolute; }

.tl_article_edit .publish_button, .tl_article_saving .publish_button { visi=
bility: visible; opacity: 1; }

.tl_article_saving .publish_button { opacity: 0.4; }

.tl_article .share_button, .tl_article_editable .edit_button { visibility: =
visible; opacity: 1; }

.tl_article_edit .edit_button, .tl_article_edit .share_button, .tl_article_=
saving .edit_button, .tl_article_saving .share_button { visibility: hidden;=
 opacity: 0; }

.tl_article .ql-container { height: auto; }

.prompt { position: absolute; inset: 0px; }

.prompt .prompt_input_wrap { overflow: hidden; }

.prompt .prompt_input { width: 100%; margin: 0px; border: none; background-=
color: transparent; box-sizing: border-box; }

.tl_tooltip { position: absolute; left: 0px; top: 0px; background-color: rg=
b(41, 41, 39); border-radius: 6px; padding: 9px 12px; line-height: 0; white=
-space: nowrap; pointer-events: none; transition: opacity 0.2s 0.06s, trans=
form 0.2s 0.06s; transform: translate3d(0px, 16px, 0px); opacity: 0; }

.tl_tooltip.bottom { transform: translate3d(0px, -16px, 0px); }

.tl_tooltip.bottom button { transform: translate3d(0px, -10px, 0px); opacit=
y: 1; }

.tl_tooltip.move_anim { transition: opacity 0.2s 0.06s, transform 0.2s 0.06=
s, top 0.2s, left 0.2s; }

.tl_tooltip.shown { pointer-events: auto; transform: translate3d(0px, 0px, =
0px); opacity: 1; }

.tl_tooltip.shown button { transform: translate3d(0px, 0px, 0px); opacity: =
1; }

.tl_tooltip.shown button.disabled { cursor: default; opacity: 0.6; }

.tl_tooltip .button_hover, .tl_tooltip button { display: inline-block; back=
ground-color: transparent; padding: 0px; margin: 0px; border-radius: 3px; b=
order: none; cursor: pointer; }

.tl_tooltip button { position: relative; transition: opacity 0.2s, transfor=
m 0.2s, background-color 0.2s; transform: translate3d(0px, 10px, 0px); opac=
ity: 0; }

.tl_tooltip button::after, .tl_tooltip button::before { content: ""; positi=
on: absolute; inset: 0px; transition: opacity 0.2s, transform 0.2s; }

.tl_tooltip button.active::after, .tl_tooltip button::before { transform: s=
cale3d(1, 1, 1); opacity: 1; }

.tl_tooltip button.active::before, .tl_tooltip button::after { transform: s=
cale3d(1.2, 1.2, 1); opacity: 0; }

.tl_tooltip button#_bold_button { transition-delay: 0s; }

.tl_tooltip button#_italic_button { transition-delay: 0.02s; }

.tl_tooltip button#_link_button { transition-delay: 0.04s; }

.tl_tooltip button#_header_button { transition-delay: 0.06s; }

.tl_tooltip button#_subheader_button { transition-delay: 0.08s; }

.tl_tooltip button#_quote_button { transition-delay: 0.1s; }

.tl_tooltip button + button { margin-left: 7px; }

.tl_tooltip button.active { background-color: rgb(234, 234, 234); }

.tl_tooltip .button_hover { background-color: rgb(84, 84, 82); }

.tl_tooltip .buttons, .tl_tooltip .prompt { transition: opacity 0.2s; }

.tl_tooltip .prompt, .tl_tooltip.tooltip_prompt .buttons { pointer-events: =
none; opacity: 0; }

.tl_tooltip.shown.buttons, .tl_tooltip.shown.tooltip_prompt .prompt { point=
er-events: auto; opacity: 1; }

.tl_tooltip .prompt_input { font-family: CustomSansSerif, "Lucida Grande", =
Arial, sans-serif; font-size: 15px; line-height: 18px; color: rgb(255, 255,=
 255); padding: 13px 10px; }

.tl_tooltip .close { float: right; width: 18px; font-size: 15px; line-heigh=
t: 18px; margin: 13px 5px; color: rgb(204, 204, 204); text-align: center; c=
ursor: pointer; transition: color 0.2s; }

